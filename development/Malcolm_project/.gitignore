# ── Runtime data directories (created by docker compose up) ──────────────────
# OpenSearch data and backups
opensearch/nodes/
opensearch-backup/

# PCAP files and uploaded data
pcap/

# Zeek and Suricata logs
zeek-logs/
suricata-logs/

# Postgres/Redis/NetBox runtime data
postgres/
redis/
netbox/media/
netbox/preload/

# ── TLS certificates and secrets (generated at runtime) ───────────────────────
logstash/certs/
filebeat/certs/
nginx/certs/
nginx/htpasswd
nginx/ca-trust/
htadmin/metadata

# OpenSearch curl credential files (generated by create_auth_files.sh)
.opensearch.primary.curlrc
.opensearch.secondary.curlrc

# OpenSearch keystore (managed by container)
opensearch/opensearch.keystore

# Auth output log (generated during setup)
auth_output.log

# ── Keep config/map placeholders but ignore real cert content ─────────────────
!logstash/maps/
!logstash/maps/*.yaml
!nginx/nginx_ldap.conf
!suricata/rules/
!suricata/include-configs/
!arkime/lua/
!arkime/rules/
!zeek/intel/
!zeek/custom/

# ── Environment secrets ───────────────────────────────────────────────────────
# .env and config/*.env contain passwords -- do not commit
.env

# ── Malcolm internal utility scripts (contain symlinks, incompatible with Windows git) ───
malcolm_scripts/

# ── Scratch/temp files created during setup ──────────────────────────────────
malcolm_tmp/
malcolm_20260219_203741_a5c6c91c/
*.tar.gz
*.zip

# ── Editor / OS noise ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
